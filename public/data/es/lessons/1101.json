{"lesson":{"id":1101,"slug":"noun-first-word-order","title":"Noun-First Word Order","subtitle":"el libro rojo, la casa blanca — painting the object before coloring it","phase":2,"shift_categories":[],"word_ids":["libro","casa","hotel","mesa","rojo","blanco","negro","verde","azul","nuevo"],"table_word_ids":["libro","casa","hotel","mesa","rojo","blanco","negro","verde","azul","nuevo"],"hook":{"title":"Canvas First, Paint Second","content":"When you say el libro rojo, your listener sees the book first and then paints it red. Practice resisting the English habit of putting colors before the noun!"},"pattern":{"title":"Gender Concord on Colors","content":"rojo/roja, blanco/blanca, negro/negra change for gender; verde and azul stay identical in the singular."},"exercises":[{"type":"matching_pairs","prompt":"Match each English expression with its Spanish partner:","matching_pairs":[{"id":"p1","english":"the red book","german":"el libro rojo"},{"id":"p2","english":"the white table","german":"la mesa blanca"},{"id":"p3","english":"the black coffee","german":"el café negro"},{"id":"p4","english":"the green house","german":"la casa verde"},{"id":"p5","english":"the blue hotel","german":"el hotel azul"},{"id":"p6","english":"the new house","german":"la casa nueva"}],"target_answer":"el libro rojo, la mesa blanca, el café negro, la casa verde, el hotel azul, la casa nueva","meaning":"the red book, the white table, the black coffee, the green house, the blue hotel, the new house","explanation":"Every color sits right after its noun.","id":"es1101_e1"},{"type":"shift_select","prompt":"Translate 'the white table':","options":["la mesa blanca","la blanca mesa","el mesa blanco"],"target_answer":"la mesa blanca","meaning":"the white table","explanation":"la mesa (feminine) + blanca (after the noun).","id":"es1101_e2"},{"type":"syntax_builder","prompt":"Assemble: 'I have the red book'","target_answer":"Tengo el libro rojo","meaning":"I have the red book","word_bank":["rojo","la","blanco","Tengo","libro","el","roja"],"explanation":"Tengo + el libro + rojo.","id":"es1101_e3"},{"type":"transcribe","prompt":"Tell me:","idea":"say that you want a new house","cues":["I want → Quiero","a house (feminine) → una casa","new (feminine, after noun) → nueva"],"idea_parts":["I want → Quiero","a house → una casa","new → nueva"],"target_answer":"Quiero una casa nueva","meaning":"I want a new house","word_bank":["nueva","una","un","casa","Quiero","nuevo","blanca"],"explanation":"Quiero una casa nueva.","id":"es1101_e4"},{"type":"dictation","prompt":"Listen and write the whole sentence.","spoken":"La casa blanca está aquí","replays":2,"target_answer":"La casa blanca está aquí","meaning":"The white house is here","cues":["The white house: La casa blanca","is (location): está","here: aquí"],"explanation":"La casa blanca está aquí.","affirmation":"Noun-first order + estar for location!","id":"es1101_e5"}],"summary":{"outcome":"Build noun + color/descriptor phrases with automatic gender concord.","use_example":{"german":"Quiero el libro rojo y la mesa blanca.","english":"I want the red book and the white table."},"takeaway":"Always name the noun before its color in Spanish.","curiosity_teaser":"Up next ([1102] Plural Concord Drills): scale up to masculine and feminine plurals (los, las, -s, -es)."},"twist":{"prompt":"Assemble: 'The green book is here'","target_answer":"El libro verde está aquí","word_bank":["aquí","El","está","La","libro","es","roja","verde"],"explanation":"verde ends in -e and fits both masculine and feminine."}},"compendium":{"words":{"libro":{"id":"libro","target_word":"libro","english_cognate":"library, libel","english_meaning":"book","gender":"el","ipa":"/ˈliβɾo/","sound_shift_ids":[],"shift_rule":"Latin liber","context_phrase":"Un libro interesante.","context_translation":"An interesting book.","etymology_derivation":"Masculine in -o: el libro.","domain":"objects"},"casa":{"id":"casa","target_word":"casa","english_cognate":"casino (Italian casa)","english_meaning":"house, home","gender":"la","ipa":"/ˈkasa/","sound_shift_ids":[],"shift_rule":"Latin casa 'cottage'","context_phrase":"La casa es grande.","context_translation":"The house is big.","etymology_derivation":"Latin casa originally meant a cottage, replacing domus in everyday Romance speech.","domain":"places"},"hotel":{"id":"hotel","target_word":"hotel","english_cognate":"hotel, hospital","english_meaning":"hotel","gender":"el","ipa":"/oˈtel/","sound_shift_ids":[],"shift_rule":"Silent H","context_phrase":"El hotel es central.","context_translation":"The hotel is central.","etymology_derivation":"Silent initial H. Latin hospitāle gives both 'hospital' and 'hotel'.","domain":"places"},"mesa":{"id":"mesa","target_word":"mesa","english_cognate":"mesa (table-top mountain)","english_meaning":"table","gender":"la","ipa":"/ˈmesa/","sound_shift_ids":[],"shift_rule":"Latin mēnsa","context_phrase":"Quiero reservar una mesa.","context_translation":"I want to reserve a table.","etymology_derivation":"Latin mēnsa ('table') gave Spanish la mesa — which English borrowed in the American Southwest for a flat-topped 'table' mountain!","domain":"objects"},"rojo":{"id":"rojo","target_word":"rojo","english_cognate":"rouge, ruby","english_meaning":"red","gender":null,"ipa":"/ˈroxo/","sound_shift_ids":[],"shift_rule":"Latin russeus","context_phrase":"El libro rojo.","context_translation":"The red book.","etymology_derivation":"Latin russeus ('reddish') → rojo. Cognate with English russet and ruby.","domain":"adjectives"},"blanco":{"id":"blanco","target_word":"blanco","english_cognate":"blank, blanket","english_meaning":"white","gender":null,"ipa":"/ˈblaŋko/","sound_shift_ids":[],"shift_rule":"Germanic blank","context_phrase":"La casa blanca.","context_translation":"The white house.","etymology_derivation":"Feminine is blanca.","domain":"adjectives"},"negro":{"id":"negro","target_word":"negro","english_cognate":"nigrescent","english_meaning":"black","gender":null,"ipa":"/ˈneɣɾo/","sound_shift_ids":[],"shift_rule":"Latin niger","context_phrase":"Un café negro.","context_translation":"A black coffee.","etymology_derivation":"Feminine is negra.","domain":"adjectives"},"verde":{"id":"verde","target_word":"verde","english_cognate":"verdant, verdure","english_meaning":"green","gender":null,"ipa":"/ˈbeɾðe/","sound_shift_ids":[],"shift_rule":"Latin viridis (invariable in -e)","context_phrase":"El jardín verde.","context_translation":"The green garden.","etymology_derivation":"Ends in -e, so masculine and feminine are identical.","domain":"adjectives"},"azul":{"id":"azul","target_word":"azul","english_cognate":"azure","english_meaning":"blue","gender":null,"ipa":"/aˈθul/","sound_shift_ids":[],"shift_rule":"Arabic lāzaward","context_phrase":"El coche azul.","context_translation":"The blue car.","etymology_derivation":"Hispano-Arabic lāzaward ('lapis lazuli') → azul. English azure is the exact same word.","domain":"adjectives"},"nuevo":{"id":"nuevo","target_word":"nuevo","english_cognate":"novel, novice","english_meaning":"new","gender":null,"ipa":"/ˈnweβo/","sound_shift_ids":[],"shift_rule":"Latin novus (o → ue)","context_phrase":"Un hotel nuevo.","context_translation":"A new hotel.","etymology_derivation":"Feminine is nueva.","domain":"adjectives"}},"shifts":{},"shiftFamilyCount":9,"compounds":[],"falseFriends":[],"dailyInsights":[]}}
