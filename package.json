{
  "name": "german-app-2",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "parse-data": "bun run scripts/parse-compendium.ts",
    "check:compendium": "bun run scripts/check-compendium.ts",
    "export-data": "bun run scripts/export-client-data.ts",
    "audit:assets": "bun run scripts/audit-public-assets.ts",
    "trail": "bun run scripts/export-trail.ts",
    "dev": "bun run export-data && next dev",
    "build": "bun run parse-data && bun run export-data && next build",
    "start": "next start",
    "test": "bun run export-data && vitest run",
    "test:e2e": "playwright test",
    "test:product": "PLAYWRIGHT_PRODUCTION=1 PLAYWRIGHT_WEB_SERVER='bun run start' playwright test product-quality.spec.ts",
    "lint": "oxlint -c .oxlintrc.json src tests scripts next.config.mjs postcss.config.mjs playwright.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "next": "^16.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxlint": "1.40.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
