{
  "name": "german-app-2",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "parse-data": "bun run scripts/parse-compendium.ts",
    "export-data": "bun run scripts/export-client-data.ts",
    "trail": "bun run scripts/export-trail.ts",
    "dev": "bun run export-data && next dev",
    "build": "bun run parse-data && bun run export-data && next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && oxlint -c .oxlintrc.json src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "oxlint": "1.40.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
